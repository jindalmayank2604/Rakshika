PORT=5000
NODE_ENV=development
JWT_SECRET=wesafe_secure_jwt_secret_token_2026
JWT_EXPIRES_IN=7d

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/wesafe_db
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=wesafe_db
DB_PORT=5432

# Google Gemini AI API Key (Optional - Fallback rule engine active if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Media Configuration (Optional - CDN upload fallback active if omitted)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Mapbox Access Token (Optional - Vector/OSM raster fallback active if omitted)
VITE_MAPBOX_TOKEN=your_mapbox_token_here
